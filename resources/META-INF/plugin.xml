<idea-plugin>
  <id>local.corp.jira.myTasks</id>
  <name>Corp Jira - My task</name>
  <version>2.24.0</version>
  <vendor url="https://denishik.io/">@denis_hik</vendor>
  <description><![CDATA[Native Jira Server / Data Center task panel for WebStorm. Browse assigned issues, descriptions, comments and attachments; manage statuses using a Personal Access Token.]]></description>
  <idea-version since-build="253" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>Git4Idea</depends>
  <extensions defaultExtensionNs="com.intellij">
    <projectConfigurable id="local.corp.jira.settings" displayName="Corp Jira - My task" instance="local.corp.jira.JiraSettings"/>
    <toolWindow id="Мои задачи Jira" anchor="bottom" icon="/icons/jiraTasks.svg" factoryClass="local.corp.jira.JiraToolWindowFactory"/>
  </extensions>
</idea-plugin>
